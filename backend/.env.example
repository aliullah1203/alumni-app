# ── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# Pooled connection — used by the app at runtime
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
# Direct connection — used ONLY by prisma migrate
DIRECT_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string_at_least_64_chars
JWT_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── Public URL (used in QR codes and emails) ─────────────────────────────────
PUBLIC_URL=http://localhost:5173

# ── File Storage ─────────────────────────────────────────────────────────────
# "local" for development, "cloudinary" for production
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# Cloudinary (only needed when STORAGE_DRIVER=cloudinary)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# S3-compatible alternative (only needed when STORAGE_DRIVER=s3)
# S3_BUCKET=your_bucket
# S3_REGION=us-east-1
# S3_ACCESS_KEY=your_access_key
# S3_SECRET_KEY=your_secret_key
# S3_ENDPOINT=          # optional, for non-AWS S3-compatible services

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# If not set, emails are logged to the console (great for development)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_app_password
# FROM_EMAIL="UITS Alumni Association" <noreply@uits.edu.bd>

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=aliullah0301@gmail.com
SMTP_PASS=etsj rmpq tjvn rtdo
SMTP_FROM=="UITS Alumni Association" <noreply@uits.edu.bd>

# ── Seed defaults ─────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@uits.edu.bd
ADMIN_PASSWORD=Admin@1234
