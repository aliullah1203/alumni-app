generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AlumniStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserRole {
  ADMIN
  EDITOR
}

model Alumni {
  id               String       @id @default(uuid())
  name             String
  registrationNo   String       @unique
  email            String       @unique
  phone            String
  batch            Int
  department       String
  faculty          String
  address          String
  about            String       @default("")
  photoUrl         String?
  showContact      Boolean      @default(false)
  socialLinks      Json         @default("{}")
  status           AlumniStatus @default(PENDING)
  verifyToken      String       @unique
  setupToken       String?      @unique
  setupTokenExpiry DateTime?
  approvedAt       DateTime?
  approvedById     String?
  approvedBy       User?        @relation("AlumniApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  alumniUser       AlumniUser?
  education        Education[]
  experience       Experience[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([status, batch])
  @@index([department])
  @@index([registrationNo])
  @@index([createdAt(sort: Desc)])
}

model AlumniUser {
  id               String    @id @default(uuid())
  alumniId         String    @unique
  alumni           Alumni    @relation(fields: [alumniId], references: [id], onDelete: Cascade)
  passwordHash     String
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Education {
  id          String   @id @default(uuid())
  alumniId    String
  alumni      Alumni   @relation(fields: [alumniId], references: [id], onDelete: Cascade)
  school      String
  degree      String?
  field       String?
  startYear   Int?
  endYear     Int?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Experience {
  id          String   @id @default(uuid())
  alumniId    String
  alumni      Alumni   @relation(fields: [alumniId], references: [id], onDelete: Cascade)
  company     String
  title       String
  startYear   Int?
  endYear     Int?
  current     Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id                 String    @id @default(uuid())
  name               String
  email              String    @unique
  passwordHash       String
  role               UserRole  @default(EDITOR)
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  approvedAlumni     Alumni[]  @relation("AlumniApprovedBy")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Notice {
  id          String   @id @default(uuid())
  title       String
  text        String
  date        DateTime @default(now())
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GalleryItem {
  id        String   @id @default(uuid())
  title     String
  caption   String?
  imageUrl  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Singleton row — always use id = 1
model SiteContent {
  id      Int  @id
  hero    Json
  about   Json
  contact Json
  footer  Json
}

// Singleton row — always use id = 1
model Settings {
  id               Int     @id
  siteName         String
  tagline          String
  registrationOpen Boolean @default(true)
}

model DailyVisit {
  date  DateTime @id
  count Int      @default(0)
}
